# Bindings for local Wrangler. Production Pages uses the dashboard bindings
# with these same names. See docs/advantage-cloud-bindings.md.
# Do not put secrets in this file.
name = "advantage-bjj-timer"
compatibility_date = "2026-11-01"
pages_build_output_dir = "dist"

# Private gym files. No public r2.dev URL.
[[r2_buckets]]
binding = "GYM_MEDIA"
bucket_name = "advantage-gym-media"

# Optional. Total bytes in the bucket before an upload is refused.
# Default 8000000000 (8 GB), under the 10 GB R2 free tier.
# [vars]
# GYM_MEDIA_CAP_BYTES = "8000000000"
# Largest one file, in bytes. Default 512000000.
# GYM_MEDIA_MAX_UPLOAD_BYTES = "512000000"

# The D1 database already exists: advantage-entitlements, binding ENTITLEMENTS_DB.
# database_id is on the dashboard. Do not invent one here.
