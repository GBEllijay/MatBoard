{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "composite": true
  },
  "include": ["vite.config.ts", "src/server/**/*.ts", "functions/**/*.ts", "src/lib/card.ts", "src/lib/checkoutProducts.ts", "src/lib/halfOff.ts", "src/lib/halfOffPage.ts", "src/lib/microsoftClientPublic.ts", "src/lib/entitlementToken.ts", "src/lib/tierImplications.ts", "src/lib/deviceProof.ts", "src/lib/legacyUnlock.ts", "src/lib/paidChunkAccess.ts", "src/lib/seatSunset.ts"],
  "exclude": ["src/server/**/*.test.ts"]
}
