# Advantage sets this when the site is built (Cloudflare Pages or CI).
# Gym owners do not fill it in, and they never paste it into the app.
# Public browser client id only. Do not add a Google client secret here or in the app.
# Leave this empty in the repo. Do not commit a real client id.
#
# The Web client’s authorized JavaScript origins should include:
#   https://advantagebjjtimer.com
#   https://www.advantagebjjtimer.com
#   plus any Cloudflare Pages or preview origin still used in beta
#   and http://localhost:5173 for local npm run dev
VITE_GOOGLE_CLIENT_ID=

# Stripe Checkout for Advantage White. Server only — do not prefix with VITE_.
# Never commit a real key. Use test mode (sk_test_ / whsec_ / price_) until launch.
# Copy this file to .env for npm run dev. On Cloudflare Pages, set the same names
# as environment variables (not build-time VITE_ vars). Card numbers stay on Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dashboard → Product catalog → Advantage White → one-time USD 9.99 → Price id.
STRIPE_PRICE_WHITE=
# Advantage Coach → one-time USD 29.99 → Price id.
# Read by gated POST /api/checkout { "product": "coach" }. Not a public home button.
STRIPE_PRICE_COACH=
# Advantage Pro → one-time USD 99.99 → Price id. First line item on the Pro session.
STRIPE_PRICE_PRO=
# Advantage Pro → recurring USD 2.99 / month → Price id. Second line item on that same session.
STRIPE_PRICE_PRO_MONTHLY=
# Optional White return overrides. Coach and Pro ignore these and use the request origin:
#   White: {origin}/buy?checkout=success&session_id={CHECKOUT_SESSION_ID}
#          {origin}/buy?checkout=cancel
#   Coach: {origin}/buy/coach?checkout=success&session_id={CHECKOUT_SESSION_ID}
#          {origin}/buy/coach?checkout=cancel
#   Pro:   {origin}/buy/pro?checkout=success&session_id={CHECKOUT_SESSION_ID}
#          {origin}/buy/pro?checkout=cancel
# STRIPE_SUCCESS_URL must include the {CHECKOUT_SESSION_ID} placeholder.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
